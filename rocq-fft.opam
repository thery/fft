# This file was generated from `meta.yml`, please do not edit manually.
# Follow the instructions on https://github.com/coq-community/templates to regenerate.

opam-version: "2.0"
maintainer: "thery@sophia.inria.fr"
version: "dev"

homepage: "https://github.com/thery/fft"
dev-repo: "git+https://github.com/thery/fft.git"
bug-reports: "https://github.com/thery/fft/issues"
license: "MIT"

synopsis: "Formalising FFT in Rocq"
description: """
This repository contains Rocq-proofs about the Fast Fourier Transform"""

build: [make "-j%{jobs}%"]
install: [make "install"]
depends: [
  "coq" 
  "coq-bignums" 
  "rocq-mathcomp-ssreflect" {(>= "2.6.0")}
  "rocq-mathcomp-algebra" {(>= "2.6.0")}
  "coq-flocq" {(>= "4.2.2")}
  "coq-interval" {(>= "4.11.5)}
  "coq-coquelicot" {(>= "3.4.5")}
]

tags: [
  "keyword:fft"
  "keyword:FFT polynomials Rocq"
  "logpath:fft"
]
authors: [
  "Laurent Théry"
]
